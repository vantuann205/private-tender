pragma language_version >= 0.23;

import CompactStandardLibrary;

// One contract instance represents one tender; metadata stays off-chain.
export enum TenderStatus { Draft, Open, Closed }
export ledger status: TenderStatus;
export ledger deadline: Uint<64>;
export ledger requirementsDigest: Bytes<32>;
export ledger submissionCount: Counter;
export ledger ownerCommitment: Bytes<32>;
export ledger enrolledVendors: Set<Bytes<32>>;
export ledger bidCommitments: Map<Bytes<32>, Bytes<32>>;

witness ownerSecret(): Bytes<32>;

circuit ownerIdentity(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "private-tender:owner:v1"), secret]);
}

circuit assertOwner(): [] {
  assert(ownerIdentity(ownerSecret()) == ownerCommitment, "Only the tender owner is authorized");
}

witness privateBidAmount(): Uint<64>;
witness vendorSecret(): Bytes<32>;
witness privateBidSalt(): Bytes<32>;

export pure circuit vendorIdentity(
  deployment: Bytes<32>,
  requirements: Bytes<32>,
  secret: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "private-tender:vendor:v2"), deployment, requirements, secret
  ]);
}

struct Bid {
  domain: Bytes<32>;
  nullifier: Bytes<32>;
  amount: Uint<64>;
}

constructor(deadlineSeconds: Uint<64>, requirementsHash: Bytes<32>) {
  assert(deadlineSeconds > 0, "Deadline must be positive");
  ownerCommitment = disclose(ownerIdentity(ownerSecret()));
  deadline = disclose(deadlineSeconds);
  requirementsDigest = disclose(requirementsHash);
  status = TenderStatus.Draft;
}

export circuit openTender(): [] {
  assertOwner();
  assert(status == TenderStatus.Draft, "Tender must be a draft");
  assert(kernel.blockTimeLessThan(deadline), "Opening deadline passed");
  status = TenderStatus.Open;
}

export circuit enrollVendor(commitment: Bytes<32>): [] {
  assertOwner();
  assert(status == TenderStatus.Draft, "Tender must be a draft");
  assert(disclose(commitment) != default<Bytes<32>>, "Missing vendor commitment");
  assert(!enrolledVendors.member(disclose(commitment)), "Vendor already enrolled");
  enrolledVendors.insert(disclose(commitment));
}

export circuit submitPrivateBid(): [] {
  assert(status == TenderStatus.Open, "Tender is not open");
  assert(kernel.blockTimeLessThan(deadline), "Bidding deadline passed");
  const vendor = vendorIdentity(kernel.self().bytes, requirementsDigest, vendorSecret());
  assert(enrolledVendors.member(disclose(vendor)), "Vendor is not enrolled");
  const amount = privateBidAmount();
  assert(amount > 0, "Bid must be positive");
  const nullifier = disclose(persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "private-tender:bidder:v2"), kernel.self().bytes, requirementsDigest, vendor
  ]));
  assert(!bidCommitments.member(nullifier), "Vendor already submitted");
  const commitment = persistentCommit<Bid>(Bid {
    domain: pad(32, "private-tender:bid:v1"), nullifier: nullifier, amount: amount
  }, privateBidSalt());
  bidCommitments.insert(nullifier, disclose(commitment));
  submissionCount.increment(1);
}

export circuit closeTender(): [] {
  assertOwner();
  assert(status == TenderStatus.Open, "Tender is not open");
  assert(kernel.blockTimeGreaterThan(deadline), "Deadline has not passed");
  status = TenderStatus.Closed;
}
