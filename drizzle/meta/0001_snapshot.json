      "checkConstraints": {
        "pt_tenders_status": {
          "name": "pt_tenders_status",
          "value": "\"pt_tenders\".\"status\" IN ('Draft', 'Open', 'Closed')"
        },
        "pt_tenders_title": {
          "name": "pt_tenders_title",
          "value": "length(trim(\"pt_tenders\".\"title\")) BETWEEN 1 AND 120"
        },
        "pt_tenders_description": {
          "name": "pt_tenders_description",
          "value": "length(trim(\"pt_tenders\".\"description\")) BETWEEN 1 AND 3000"
        },
        "pt_tenders_requirements": {
          "name": "pt_tenders_requirements",
          "value": "cardinality(\"pt_tenders\".\"requirements\") BETWEEN 1 AND 1500 AND length(array_to_string(\"pt_tenders\".\"requirements\", E'\n')) <= 3000"
        },
        "pt_tenders_winner_rule": {
          "name": "pt_tenders_winner_rule",
          "value": "\"pt_tenders\".\"winner_rule\" IN ('Lowest eligible bid', 'Manual review (future)')"
        }
