# Server-only Neon pooled PostgreSQL URL (TLS enabled); never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Direct/unpooled URL for migrations. Store actual values only in ignored .env.local or host secrets.
DATABASE_URL_UNPOOLED=
# Optional opt-in API integration test target; the app must already be running against this database.
TEST_BASE_URL=http://localhost:3111
